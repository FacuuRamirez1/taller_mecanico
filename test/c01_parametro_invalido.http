# Ejecutar python seed.py antes de este archivo
@baseUrl = http://localhost:8000

### C-01: Parámetro de ruta no entero en repuestos
# FastAPI valida el tipo del parámetro antes de invocar el handler.
# Esperado: 422 Unprocessable Entity
# {
#   "detail": [
#     {
#       "type": "int_parsing",
#       "loc": ["path", "repuesto_id"],
#       "msg": "Input should be a valid integer, unable to parse string as an integer"
#     }
#   ]
# }
GET {{baseUrl}}/repuestos/abc

