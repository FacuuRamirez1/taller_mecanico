# 1) URL: postgresql+asyncpg://postgres:<password-local>@localhost:5432/taller_mecanico
# 2) Venv: python -m venv .venv && source .venv/Scripts/activate
# 3) Arranque: uvicorn main:app --reload        (desde C-01)
# 4) Migrar: alembic upgrade head               (desde C-01)
# 5) Seed: python seed.py                       (desde C-03)
#
# ---------------------------------------------------------------------------
# Contrato de configuracion del TP: 13 variables (knowledge-base/08, 130-148).
# Copiar este archivo a .env y completar SOLO los dos secretos:
#   POSTGRES_PASSWORD  y  JWT_SECRET_KEY
# .env NO se versiona (esta en .gitignore). Nunca escribir valores reales aca.
# ---------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_EN_TU_.env
POSTGRES_DB=taller_mecanico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Calculada con @computed_field en Settings (C-01). NO se escribe en .env.

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=1800
BCRYPT_COST=12
DB_POOL_SIZE=5
SQL_ECHO=true
COOKIE_SECURE=false
